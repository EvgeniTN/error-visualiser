{
	"name": "error-visualiser",
	"displayName": "Error Visualiser",
	"description": "",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "error-visualiser.errorView",
				"title": "errorView"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run build:webview",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "react-scripts test",
		"postinstall": "node ./node_modules/vscode/bin/install",
		"build:webview": "webpack --config webpack.config.js",
		"build": "webpack"
	},
	"jest": {
		"testEnvironment": "node"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@types/jest": "^29.5.14",
		"@types/mocha": "^10.0.10",
		"@types/node": "^14.14.6",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@types/testing-library__react": "^10.0.1",
		"@types/vscode": "^1.96.0",
		"@typescript-eslint/eslint-plugin": "^8.17.0",
		"@typescript-eslint/parser": "^8.17.0",
		"@vscode/test-cli": "^0.0.10",
		"@vscode/test-electron": "^2.4.1",
		"css-loader": "^7.1.2",
		"dotenv-webpack": "^8.1.0",
		"eslint": "^9.16.0",
		"html-webpack-plugin": "^5.6.3",
		"react-scripts": "^5.0.1",
		"style-loader": "^4.0.0",
		"ts-loader": "^9.5.2",
		"typescript": "^4.0.3",
		"webpack": "^5.97.1",
		"webpack-cli": "^4.10.0"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"vscode": "^1.1.37"
	},
	"author": "",
	"license": "ISC"
}
