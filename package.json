{
	"name": "error-visualiser",
	"displayName": "Error Visualiser",
	"description": "",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.96.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "error-visualiser.errorView",
				"title": "errorView"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run build:webview",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test",
		"postinstall": "node ./node_modules/vscode/bin/install",
		"build:webview": "webpack --config webpack.config.js"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^14.14.6",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@types/vscode": "^1.96.0",
		"@typescript-eslint/eslint-plugin": "^8.17.0",
		"@typescript-eslint/parser": "^8.17.0",
		"@vscode/test-cli": "^0.0.10",
		"@vscode/test-electron": "^2.4.1",
		"eslint": "^9.16.0",
		"typescript": "^4.0.3",
		"webpack": "^5.4.0",
		"webpack-cli": "^4.2.0"
	},
	"dependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"ts-loader": "^8.0.4",
		"vscode": "^1.1.37"
	},
	"author": "",
	"license": "ISC"
}
